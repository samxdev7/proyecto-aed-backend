DB_URL=jdbc:postgresql://aws-0-us-west-2.pooler.supabase.com:5432/postgres?sslmode=require
DB_USER= reemplaza por aqui
DB_PASSWORD= reemplaza por aqui

# IMPORTANTE: mínimo 32 bytes. Genera el tuyo con:
#   openssl rand -base64 32
# (un secret corto rompe el arranque: jjwt exige >= 256 bits para HS256)
JWT_SECRET= reemplaza por aqui
GOOGLE_CLIENT_ID=reemplaza por aqui
SUPABASE_URL=https://tu-proyecto.supabase.co
# Orígenes CORS permitidos (usa '*' para permitir cualquier origen de despliegue, o lista separada por comas)
CORS_ORIGINS=* # Ej. http://localhost:3000,https://cnm-inscripcion.vercel.app,https://*.vercel.app
PORT=8080

# ==============================================================================
# Configuración SMTP para Envío de Correos Institucionales (Aprobación/Rechazo)
# ==============================================================================
# Mini-indicaciones de configuración:
#
# Opción A) Usar Gmail SMTP (Recomendado):
#   1. En la cuenta de Google (Gmail), activa la Verificación en 2 Pasos (2FA).
#   2. Ve a: https://myaccount.google.com/apppasswords
#   3. Genera una nueva "Contraseña de aplicación" (16 caracteres).
#   4. Asigna los siguientes valores:
#      - MAIL_HOST=smtp.gmail.com
#      - MAIL_PORT=587
#      - MAIL_USERNAME=tu_cuenta_oficial@gmail.com
#      - MAIL_PASSWORD=tu_contraseña_de_aplicacion_de_16_caracteres_sin_espacios
#      - MAIL_FROM=tu_cuenta_oficial@gmail.com
#      - MAIL_SMTP_AUTH=true
#      - MAIL_SMTP_STARTTLS=true
#
# Opción B) Relay Serverless en Vercel (Recomendado para Render Free Tier - $0.00, sin dominio propio):
#   Render Free Tier bloquea por firewall del kernel los puertos SMTP 25, 465 y 587.
#   El frontend en Vercel expone un endpoint seguro HTTPS (puerto 443) que conecta con Google SMTP.
#   - MAIL_RELAY_URL=https://cnm-inscripcion.vercel.app/api/internal/email
#   - INTERNAL_EMAIL_SECRET=misma_clave_secreta_configurada_en_vercel
#
# Opción C) Proveedores HTTP alternativos (HTTPS puerto 443):
#   - Resend (https://resend.com): RESEND_API_KEY=re_123456789...
#   - Brevo (https://brevo.com): BREVO_API_KEY=xkeysib-123456789...
#
MAIL_RELAY_URL=
INTERNAL_EMAIL_SECRET=
RESEND_API_KEY=
BREVO_API_KEY=

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=tu_correo@ejemplo.com
MAIL_PASSWORD=tu_contraseña_de_aplicacion
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_FROM=tu_correo@ejemplo.com