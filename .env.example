# Copiar a .env y ajustar. La BD puede ser Postgres local o Supabase.
DB_URL=jdbc:postgresql://localhost:5432/cnm
DB_USER=postgres
DB_PASSWORD=cnm123

# IMPORTANTE: mínimo 32 bytes. Genera el tuyo con:
#   openssl rand -base64 32
# (un secret corto rompe el arranque: jjwt exige >= 256 bits para HS256)
JWT_SECRET=c2FtcGxlLXNlY3JldC1kZS1kZXNhcnJvbGxvLTMyLWJ5dGVzLW1pbmltbw==

PORT=8080

# Opcional: orígenes CORS permitidos, separados por comas.
# Sin definir (o "*") acepta cualquier origen — funciona con cualquier
# puerto que asigne `next dev`. En producción p.ej.:
# CORS_ORIGINS=https://cnm-frontend.vercel.app,https://cnm.org
